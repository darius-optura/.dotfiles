#!/usr/bin/env bash
# Push this Mac's herdr agent list to desk (the Pixel desk dashboard).
# The com.darius.herdr-desk-push LaunchAgent runs it every 10 s.
# DESK_URL comes from ~/.config/desk/push.env (per machine, not in this repo).
# Usage: herdr-desk-push [--dry-run]
set -euo pipefail

env_file="${HERDR_DESK_ENV:-$HOME/.config/desk/push.env}"
[[ -f "$env_file" ]] || exit 0
# shellcheck source=/dev/null
source "$env_file"
[[ -n "${DESK_URL:-}" ]] || exit 0

# No herdr server running means no agents: send an empty list.
body=$(herdr agent list 2>/dev/null) || body=''
[[ -n "$body" ]] || body='{"agents": []}'
url="${DESK_URL%/}/herdr?mac=$(hostname -s)"

if [[ "${1:-}" == "--dry-run" ]]; then
    printf '%s\n%s\n' "$url" "$body"
    exit 0
fi

printf '%s' "$body" | curl -fsS -m 5 -X POST -H 'Content-Type: application/json' --data-binary @- "$url" >/dev/null
