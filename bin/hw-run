#!/usr/bin/env fish

# Prompt for a branch name, then spin up an isolated worktree run via `hw`
# (create worktree off origin/main, bootstrap, lay out nvim + claude + shell).
# Bound to super+r via a herdr [[keys.command]] popup. Run from inside a repo.

if not git rev-parse --git-dir >/dev/null 2>&1
    echo "hw-run: not inside a git repository" >&2
    read -P 'press enter to close'
    exit 1
end

read -P 'new run — branch name: ' branch
test -z "$branch"; and exit 0

hw $branch
