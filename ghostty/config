font-size = 15
font-family = Berkeley Mono Variable
font-family-bold = Berkeley Mono Variable Regular Bold
font-family-italic = Berkeley Mono Variable Italic Regular
font-family-bold-italic = Berkeley Mono Variable Italic Bold Italic
# Nerd Font fallback for powerline glyphs and icons (used by tmux pills)
font-family = Hack Nerd Font Mono

# Branch shell by host app (Ghostty -> fish+tmux, Supacode -> zsh, no tmux)
command = /Users/darius/.dotfiles/scripts/ghostty-shell

shell-integration = fish
theme = cyberdream
window-decoration = false
window-padding-x = 0
window-padding-y = 0
background-opacity = 0.7
background-blur-radius = 40

auto-update-channel = tip

scrollback-limit = 1000000000

keybind = super+f=text:\x02f
keybind = super+g=text:\x02g
keybind = super+comma=text:\x02,
keybind = super+k=text:\x02w
keybind = super+digit_1=text:\x021
keybind = super+digit_2=text:\x022
keybind = super+digit_3=text:\x023
keybind = super+digit_4=text:\x024
keybind = super+digit_5=text:\x025
keybind = super+digit_6=text:\x026
keybind = super+digit_7=text:\x027
keybind = super+digit_8=text:\x028
keybind = super+digit_9=text:\x029
keybind = super+L=text:\x02L
keybind = super+[=text:\x02e
keybind = super+shift+[=text:\x02p
keybind = super+shift+n=text:\x02-
keybind = super+n=text:\x02v
keybind = super+q=text:\x02q
keybind = super+shift+]=text:\x02n
keybind = super+s=text:\x1b:w\n
keybind = super+t=text:\x02c
keybind = super+shift+t=text:\x02!
keybind = super+w=text:\x02x
keybind = super+z=text:\x02z
keybind = super+r=text:INTENT_WORKTREE_SKIP_SEED=true npm run dev:isolated\n
keybind = super+m=text:\x02m
keybind = super+up=text:\x02k
keybind = super+down=text:\x02j
keybind = super+left=text:\x02h
keybind = super+right=text:\x02l
# Worktree keys (herdr): create / open picker / remove
keybind = super+shift+g=text:\x02G
keybind = super+shift+o=text:\x02O
keybind = super+alt+d=text:\x02\x1bd

# Opt+Backspace -> ESC DEL (word-delete) in terminals, incl. Supacode embed
macos-option-as-alt = true
