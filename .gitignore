# Plugin directories
tmux/plugins
tmux-sessionizer/config
nvim/plugin

# Fish shell runtime
fish/fish_variables


# SSH configs (sensitive)
ssh

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Backup files
*.bak
*.backup
*~

# Log files
*.log

# Lazy.nvim lock file (uncomment if you want to ignore)
# nvim/lazy-lock.json

# Temporary files
tmp/
temp/

# Editor swap files
*.swp
*.swo
*~

# Local customizations (not tracked)
local/
*.local

# Fish completions cache
fish/completions/*.fish

# Oh-my-fish
fish/conf.d/omf.fish

# Fish plugins: fisher installs these per machine from fish/fish_plugins
fish/functions/fisher.fish
fish/functions/nvm.fish
fish/functions/_nvm_*.fish
fish/conf.d/nvm.fish
fish/themes/catppuccin-*.theme
fish/themes/static/

# Installation manifest (machine-specific)
.install-manifest.json

# Re-include skill source files that global ~/.gitignore would otherwise hide
!claude/skills/**/LANGUAGE.md
!claude/skills/**/CONTEXT.md
!claude/skills/**/CONTEXT-MAP.md
!claude/skills/**/ADR-*.md
